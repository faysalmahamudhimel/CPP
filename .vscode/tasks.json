{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build destructor example",
      "type": "process",
      "command": "g++",
      "args": [
        "OOP/destructor/main.cpp",
        "OOP/destructor/student.cpp",
        "-o",
        "OOP/destructor/destructor.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
